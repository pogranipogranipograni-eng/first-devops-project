git log --oneline# jedna linia na commit
git log --graph --oneline --decorate# z rysunkiem gałęzi
git log -3# trzy ostatnie
git log --since="2 weeks ago"# zakres czasu
git log --author="Kowalski"# po autorze
git log -p plik.txt# historia jednego pliku z różnicami
git log --stat# statystyka zmienionych plików
git log --grep="fix"# po treści komunikatu
git log -S "nazwa_funkcji"# commity, które dodały lub usunęły ten
tekst
git show 7b1d4e2# szczegóły jednego commitu
git show 7b1d4e2 --no-patch# tylko metadane
git show 7b1d4e2 -- plik.txt# tylko zmiany w jednym pliku
